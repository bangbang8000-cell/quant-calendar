# ==========================================
# 量化选股日历 - Git 忽略规则
# ==========================================

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
*.egg
dist/
build/
# V4.3 (方案A): 前端构建产物入库 (Docker/ops 无需 Node 构建) - 仅 frontend/dist 例外
!frontend/dist/
!frontend/dist/**
node_modules/
frontend/node_modules

# Virtual environments
venv/
.venv/
env/
.env

# Environment files (secrets)
.env
*.env.local
*.env.production

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# User data (generated at runtime)
quant-calendar-ops/data/
data/
*.db
*.sqlite3

# Logs
*.log
logs/

# Archives & releases
*.tar.gz
*.zip
quant-calendar-ops/releases/
quant-calendar-ops/versions/

# Backup files
*.backup*
*.bak
*.original*
*_bak*

# Dev artifacts (screenshots / dogfood walkthrough outputs)
_shots/
dogfood-output/

# start-dev.ps1 的依赖安装标记（每次首次运行自动生成，属本地产物）
.deps_installed

# IDE auxiliary (planning docs, agent scratch)
.trae/

# OS files
.DS_Store
Thumbs.db

# Dev scripts (local only)
quant-calendar-ops/dev.sh
quant-calendar-ops/dev.bat
quant-calendar-ops/start.sh
quant-calendar-ops/start.bat
quant-calendar-ops/release.sh

# Dev plans
.hermes/
PLAN.md

# Pytest cache
.pytest_cache/

# qresult CSV source (tracked via Git LFS or direct, decide per release)

# Coverage output
.coverage
htmlcov/

# Visual regression (FR-3.11.9 / TC-11.14): 本次运行截图与报告为生成产物, 不入库
# 仅入库基线 baseline/ (参考截图)
tests/e2e/screenshots/current/
tests/e2e/reports/

# V4.6: 归档文档(旧版本) 本地保留, 不同步 GitHub
docs/archive/

# V4.8.2 精简: 运行产物与历史审计截图本地归档, 不入库
qresult/
screenshots/
assets/screenshots/audit-*/
assets/screenshots/*.jpg

reports/

# 部署/演练产生的数据备份目录（含 app.db / audit.log / groups.json 等生产数据，绝不入库）
data-backup-*/

docs/audits/

docs/superpowers/

docs/reports/

.task-state.json

frontend/_new_script.html

frontend/_extract_modules.py

frontend/static/test.html

frontend/api-docs.html
.shot-collapsed.png

# 6.6: 数据订正前的本地备份（含 app.db 等运行时数据, 不入库）
backups/

# 2026-11 用户决定: 同花顺 Fuyao 对接的评估/规划/PRD 仅本地留存, 不同步 GitHub
# (内容仍在 docs/ 下可直接阅读; 此处只加忽略规则, 避免 git add -A 误提交)
docs/EVAL-FUYAO-DATA-PLATFORM-v6.6.md
docs/PRD-FUYAO-v6.7-v7.0.md
docs/ROADMAP-FUYAO-v6.7-v7.0.md
