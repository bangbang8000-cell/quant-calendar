{
  "name": "quant-calendar-frontend",
  "private": true,
  "description": "Vite 构建层 — 业务 JS 按域分包(首屏 index + 5 域懒加载), 首屏哈希缓存破坏; CSS 由 scripts/build_css.py 合并为 app.css",
  "scripts": {
    "css": "python3 scripts/build_css.py",
    "registry": "python3 scripts/gen_el_registry.py",
    "check": "python3 scripts/build_css.py --check && python3 scripts/gen_el_registry.py --check",
    "build": "python3 scripts/build_css.py && vite build",
    "build:direct": "python3 scripts/build_css.py && node node_modules/vite/bin/vite.js build"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "vite": "^5.4.21"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@fontsource/inter": "^5.3.0",
    "element-plus": "^2.14.5",
    "lucide-vue-next": "^0.577.0",
    "vue": "^3.5.42"
  }
}
